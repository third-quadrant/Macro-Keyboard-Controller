<Window x:Class="Fireworm.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="매크로 키보드 컨트롤러"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1180" Height="840" MinWidth="1020" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="94"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="188"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="20,14,20,0" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="16" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="매크로 키보드 컨트롤러" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="made by third_quadrant" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="32,0,0,0">
                    <Border x:Name="DeviceStatusPill" Background="#2A2318" CornerRadius="11" Padding="11,5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DeviceStatusDot" Width="8" Height="8" Fill="{StaticResource Yellow}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DeviceStatusText" Text="확인 중" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="DeviceInfoText" Text="MINI KeyBoard · VID 1189 / PID 8890" FontSize="12" Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="DevicePathText" Text="MI_01 대기" FontSize="10" Foreground="#656F80" MaxWidth="400" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="TriggerSetupButton" Content="장치 트리거 설정" AutomationProperties.AutomationId="OpenTriggerWizard" Style="{StaticResource PrimaryButton}"
                                Margin="0,0,10,0" Click="OpenTriggerWizard_Click"/>
                        <Button Content="새로고침" Style="{StaticResource GhostButton}" Click="Refresh_Click"/>
                    </StackPanel>
                    <CheckBox x:Name="AutoStartCheck" Content="Windows 시작 시 자동 실행" FontSize="11"
                              Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,8,2,0"
                              Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="20,16,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.9*"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <TextBlock Text="키 매핑" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="물리 버튼을 고르고, 그 버튼이 실행할 동작 하나를 지정하세요."
                           Style="{StaticResource MutedText}" Margin="0,0,0,4"/>

                <UniformGrid Columns="3" Rows="2" Margin="0,4,0,0">
                    <Button x:Name="Key1Card" Tag="KEY1" AutomationProperties.AutomationId="CardKey1" Style="{StaticResource KeyCard}" Height="112" Click="KeyCard_Click">
                        <StackPanel>
                            <TextBlock Text="KEY 1" Style="{StaticResource CardLabel}"/>
                            <TextBlock x:Name="Key1Summary" Text="설정 안 됨" Style="{StaticResource CardSummary}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="Key2Card" Tag="KEY2" Style="{StaticResource KeyCard}" Height="112" Click="KeyCard_Click">
                        <StackPanel>
                            <TextBlock Text="KEY 2" Style="{StaticResource CardLabel}"/>
                            <TextBlock x:Name="Key2Summary" Text="설정 안 됨" Style="{StaticResource CardSummary}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="Key3Card" Tag="KEY3" Style="{StaticResource KeyCard}" Height="112" Click="KeyCard_Click">
                        <StackPanel>
                            <TextBlock Text="KEY 3" Style="{StaticResource CardLabel}"/>
                            <TextBlock x:Name="Key3Summary" Text="설정 안 됨" Style="{StaticResource CardSummary}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="Key4Card" Tag="KEY4" AutomationProperties.AutomationId="CardKey4" Style="{StaticResource KeyCard}" Height="112" Click="KeyCard_Click">
                        <StackPanel>
                            <TextBlock Text="KEY 4" Style="{StaticResource CardLabel}"/>
                            <TextBlock x:Name="Key4Summary" Text="설정 안 됨" Style="{StaticResource CardSummary}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="Key5Card" Tag="KEY5" AutomationProperties.AutomationId="CardKey5" Style="{StaticResource KeyCard}" Height="112" Click="KeyCard_Click">
                        <StackPanel>
                            <TextBlock Text="KEY 5" Style="{StaticResource CardLabel}"/>
                            <TextBlock x:Name="Key5Summary" Text="설정 안 됨" Style="{StaticResource CardSummary}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="Key6Card" Tag="KEY6" AutomationProperties.AutomationId="CardKey6" Style="{StaticResource KeyCard}" Height="112" Click="KeyCard_Click">
                        <StackPanel>
                            <TextBlock Text="KEY 6" Style="{StaticResource CardLabel}"/>
                            <TextBlock x:Name="Key6Summary" Text="설정 안 됨" Style="{StaticResource CardSummary}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <TextBlock Text="노브" Style="{StaticResource SectionTitle}" Margin="0,16,0,4"/>
                <UniformGrid Columns="3" Rows="1">
                    <Button x:Name="KnobLeftCard" Tag="KNOB_LEFT" Style="{StaticResource KeyCard}" Height="84" Click="KeyCard_Click">
                        <StackPanel>
                            <TextBlock Text="← 왼쪽" Style="{StaticResource CardLabel}"/>
                            <TextBlock x:Name="KnobLeftSummary" Text="설정 안 됨" Style="{StaticResource CardSummary}" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="KnobClickCard" Tag="KNOB_CLICK" Style="{StaticResource KeyCard}" Height="84" Click="KeyCard_Click">
                        <StackPanel>
                            <TextBlock Text="● 클릭" Style="{StaticResource CardLabel}"/>
                            <TextBlock x:Name="KnobClickSummary" Text="설정 안 됨" Style="{StaticResource CardSummary}" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="KnobRightCard" Tag="KNOB_RIGHT" Style="{StaticResource KeyCard}" Height="84" Click="KeyCard_Click">
                        <StackPanel>
                            <TextBlock Text="→ 오른쪽" Style="{StaticResource CardLabel}"/>
                            <TextBlock x:Name="KnobRightSummary" Text="설정 안 됨" Style="{StaticResource CardSummary}" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="13" Padding="14" Margin="5,14,5,0">
                    <StackPanel>
                        <TextBlock Text="시뮬레이션" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="장치 없이 앱의 입력 → 액션 경로를 실행합니다. 실제 장치 설정은 위의 '장치 트리거 설정'에서 합니다."
                                   Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="KEY1" Tag="KEY1" AutomationProperties.AutomationId="SimKey1" Style="{StaticResource SimButton}" Click="Simulate_Click"/>
                            <Button Content="KEY2" Tag="KEY2" AutomationProperties.AutomationId="SimKey2" Style="{StaticResource SimButton}" Click="Simulate_Click"/>
                            <Button Content="KEY3" Tag="KEY3" AutomationProperties.AutomationId="SimKey3" Style="{StaticResource SimButton}" Click="Simulate_Click"/>
                            <Button Content="KEY4" Tag="KEY4" AutomationProperties.AutomationId="SimKey4" Style="{StaticResource SimButton}" Click="Simulate_Click"/>
                            <Button Content="KEY5" Tag="KEY5" AutomationProperties.AutomationId="SimKey5" Style="{StaticResource SimButton}" Click="Simulate_Click"/>
                            <Button Content="KEY6" Tag="KEY6" AutomationProperties.AutomationId="SimKey6" Style="{StaticResource SimButton}" Click="Simulate_Click"/>
                            <Button Content="노브 ←" Tag="KNOB_LEFT" AutomationProperties.AutomationId="SimKnobLeft" Style="{StaticResource SimButton}" Click="Simulate_Click"/>
                            <Button Content="노브 클릭" Tag="KNOB_CLICK" AutomationProperties.AutomationId="SimKnobClick" Style="{StaticResource SimButton}" Click="Simulate_Click"/>
                            <Button Content="노브 →" Tag="KNOB_RIGHT" AutomationProperties.AutomationId="SimKnobRight" Style="{StaticResource SimButton}" Click="Simulate_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Editor -->
            <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="16" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="EditorTitle" Text="KEY 1 동작" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock x:Name="EditorSubtitle" Text="바꾸면 바로 저장됩니다."
                                   Style="{StaticResource MutedText}" Margin="0,5,0,18"/>

                        <TextBlock Text="동작 종류" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ActionTypeCombo" AutomationProperties.AutomationId="ActionTypeCombo" SelectionChanged="ActionTypeCombo_SelectionChanged" Margin="0,0,0,14">
                            <ComboBoxItem Content="설정 안 됨" Tag="none"/>
                            <ComboBoxItem Content="키 입력" Tag="keyboard"/>
                            <ComboBoxItem Content="텍스트 입력" Tag="text"/>
                            <ComboBoxItem Content="프로그램 실행" Tag="launch"/>
                            <ComboBoxItem Content="미디어 제어" Tag="media"/>
                            <ComboBoxItem Content="마우스 동작" Tag="mouse"/>
                        </ComboBox>

                        <StackPanel x:Name="NonePanel" Visibility="Collapsed">
                            <TextBlock Text="이 버튼에는 아직 동작이 없습니다." Style="{StaticResource MutedText}"/>
                        </StackPanel>

                        <StackPanel x:Name="KeyboardPanel" Visibility="Collapsed">
                            <TextBlock Text="키 / 조합" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="KeyComboBox" AutomationProperties.AutomationId="KeyComboInput" Height="36"
                                     LostFocus="Field_LostFocus" KeyDown="Field_KeyDown"/>
                            <TextBlock Text="예: C, Ctrl+Z, Ctrl+Shift+S, F11" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel x:Name="TextPanel" Visibility="Collapsed">
                            <TextBlock Text="입력할 텍스트" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TextValueBox" Height="84" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" LostFocus="Field_LostFocus"/>
                        </StackPanel>

                        <StackPanel x:Name="LaunchPanel" Visibility="Collapsed">
                            <TextBlock Text="설치된 프로그램" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,12">
                                <ComboBox x:Name="InstalledProgramCombo" DisplayMemberPath="Name"
                                          SelectionChanged="InstalledProgramCombo_SelectionChanged"/>
                                <TextBlock Text="설치된 프로그램에서 선택" IsHitTestVisible="False" Margin="13,0,0,0"
                                           VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=InstalledProgramCombo}" Value="-1">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <TextBlock Text="프로그램 / 파일 경로" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="LaunchPathBox" Height="36" Grid.Column="0"
                                         LostFocus="Field_LostFocus" KeyDown="Field_KeyDown"/>
                                <Button Content="찾아보기" Style="{StaticResource GhostButton}" Grid.Column="1"
                                        Margin="8,0,0,0" Padding="12,7" Click="Browse_Click"/>
                            </Grid>
                            <TextBlock Text="실행 인자 (선택)" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                            <TextBox x:Name="LaunchArgsBox" Height="36" LostFocus="Field_LostFocus" KeyDown="Field_KeyDown"/>
                        </StackPanel>

                        <StackPanel x:Name="MediaPanel" Visibility="Collapsed">
                            <TextBlock Text="미디어 동작" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="MediaCombo" SelectionChanged="OptionCombo_SelectionChanged">
                                <ComboBoxItem Content="볼륨 증가" Tag="volume_up"/>
                                <ComboBoxItem Content="볼륨 감소" Tag="volume_down"/>
                                <ComboBoxItem Content="음소거" Tag="mute"/>
                                <ComboBoxItem Content="재생/일시정지" Tag="play_pause"/>
                                <ComboBoxItem Content="다음 트랙" Tag="next"/>
                                <ComboBoxItem Content="이전 트랙" Tag="prev"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel x:Name="MousePanel" Visibility="Collapsed">
                            <TextBlock Text="마우스 동작" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="MouseCombo" SelectionChanged="OptionCombo_SelectionChanged">
                                <ComboBoxItem Content="왼쪽 클릭" Tag="left_click"/>
                                <ComboBoxItem Content="오른쪽 클릭" Tag="right_click"/>
                                <ComboBoxItem Content="가운데 클릭" Tag="middle_click"/>
                                <ComboBoxItem Content="스크롤 위" Tag="wheel_up"/>
                                <ComboBoxItem Content="스크롤 아래" Tag="wheel_down"/>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock x:Name="EditorStatus" Style="{StaticResource MutedText}" Margin="0,16,0,0"/>

                        <Border Background="#101720" BorderBrush="#26364A" BorderThickness="1" CornerRadius="10"
                                Padding="12" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="장치 트리거" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                <TextBlock x:Name="TriggerStatusText" Text="장치를 연결하고 트리거 설정을 진행하세요."
                                           Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Activity log -->
        <Border Grid.Row="2" Margin="20,16,20,20" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="16" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock Text="최근 활동" FontSize="13" FontWeight="SemiBold"/>
                    <Button Content="지우기" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                            Padding="10,5" FontSize="11" Click="ClearLog_Click"/>
                </Grid>
                <ListBox x:Name="LogList" Grid.Row="1" Margin="0,8,0,0" FontFamily="Consolas, Cascadia Mono"
                         FontSize="11" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>
    </Grid>
</Window>
