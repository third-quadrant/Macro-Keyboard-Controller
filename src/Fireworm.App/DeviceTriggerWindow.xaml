<Window x:Class="Fireworm.App.DeviceTriggerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="장치 트리거 설정"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="780" Height="820" MinWidth="680" MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="18,16,18,0" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="16" Padding="20,14">
            <Grid>
                <StackPanel>
                    <TextBlock Text="장치 트리거 설정" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="KEY1~KEY6을 내부 트리거로 변경하고, 실제 입력을 확인합니다."
                               Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Background="#2A2318" CornerRadius="10" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="DeviceStatusText" Text="확인 중" FontSize="12" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="18,14,18,0">
            <StackPanel>
                <Border Background="#2A1B1B" BorderBrush="#5A3030" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="중요 — 장치 설정이 변경됩니다" FontWeight="SemiBold" Foreground="#FFB4B4"/>
                        <TextBlock Text="이 장치는 전체 설정 읽기를 지원하지 않습니다. 아래 백업은 '현재 키가 내보내는 동작'을 기록한 행동 수준 백업입니다. 적용 전에 반드시 백업을 저장하고, 실패 시 '전체 복구'를 사용하세요. 이 앱은 사용자가 버튼을 눌렀을 때만 장치에 씁니다."
                                   Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="1. 현재 동작 백업" Style="{StaticResource SectionTitle}"/>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="14">
                    <StackPanel>
                        <TextBlock x:Name="BackupPathText" Style="{StaticResource MutedText}"/>
                        <ListBox x:Name="BackupList" Height="130" Margin="0,8,0,0" FontFamily="Consolas, Cascadia Mono" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="기본 백업 저장 (A/C)" Style="{StaticResource GhostButton}" Click="SaveDefaultBackup_Click"/>
                            <Button Content="현재 동작 녹음" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="RecordBackup_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="RecordStatusText" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="2. 내부 트리거 적용" Style="{StaticResource SectionTitle}" Margin="0,16,0,4"/>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="14">
                    <StackPanel>
                        <TextBlock Text="KEY1~KEY6을 각각 F13~F18로 변경합니다. F13~F18은 물리 키를 구분하기 위한 내부 신호이며, 사용자가 일반 설정에서 입력할 필요는 없습니다."
                                   Style="{StaticResource MutedText}"/>
                        <CheckBox x:Name="ConfirmCheck" Margin="0,12,0,0"
                                  Content="백업을 확인했고, KEY1~KEY6의 내부 트리거를 변경하는 데 동의합니다."/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="ApplyKey1Button" Content="KEY1만 시험 적용" Style="{StaticResource PrimaryButton}" Click="ApplyKey1_Click"/>
                            <Button x:Name="ApplyRestButton" Content="나머지 5개 적용" Style="{StaticResource GhostButton}" Margin="8,0,0,0" IsEnabled="False" Click="ApplyRest_Click"/>
                            <Button x:Name="RestoreButton" Content="전체 복구" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Restore_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="ApplyStatusText" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
                        <ListBox x:Name="VerifyList" Height="130" Margin="0,8,0,0" FontFamily="Consolas, Cascadia Mono" FontSize="12"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="3. 복구 안내" Style="{StaticResource SectionTitle}" Margin="0,16,0,4"/>
                <Border Background="#101720" BorderBrush="#26364A" BorderThickness="1" CornerRadius="12" Padding="14">
                    <TextBlock Text="'전체 복구'는 백업 파일의 usage를 KEY1~KEY6에 다시 기록합니다. 전체 설정 덤프가 아니므로, 백업 이후에 다른 도구로 설정을 바꿨다면 원래 값과 다를 수 있습니다. 복구 후 각 키를 눌러 백업한 동작이 나오는지 확인하세요."
                               Style="{StaticResource MutedText}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="18,14,18,16">
            <Button Content="닫기" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Width="100" Click="Close_Click"/>
        </Border>
    </Grid>
</Window>
